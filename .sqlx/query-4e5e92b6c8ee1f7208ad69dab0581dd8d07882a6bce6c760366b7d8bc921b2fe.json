{
  "db_name": "PostgreSQL",
  "query": "SELECT wd.id, wd.endpoint_id, wd.event_type, wd.payload, wd.attempts,\n                  we.url, we.secret\n           FROM webhook_deliveries wd\n           JOIN webhook_endpoints we ON wd.endpoint_id = we.id\n           WHERE wd.status = 'pending' AND wd.next_attempt_at <= NOW()\n           LIMIT 20",
